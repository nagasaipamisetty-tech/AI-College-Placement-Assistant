# Copy this file to .env and fill in your values
# Never commit the actual .env file

# Database (SQLite default — no changes needed for local dev)
DATABASE_URL=sqlite:///./placement.db

# JWT Secret — change this to any long random string in production
SECRET_KEY=your-secret-key-change-this-in-production

# CORS — frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Hugging Face token for AI-enhanced cover letters
# Leave blank to use template-based generation (works without this)
HUGGINGFACE_API_TOKEN=

# Optional: App name
APP_NAME=AI College Placement Assistant
